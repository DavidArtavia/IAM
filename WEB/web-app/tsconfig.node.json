{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    /* para poder escribir import "./foo.ts" */
    "allowImportingTsExtensions": true,

    /* ⇒ cumple TS5096 y TS6310                       */
    "declaration": true,            // genera tipos
    "emitDeclarationOnly": true,    // solo .d.ts, nada de JS

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts"]     // evita recorrer src/**
}
